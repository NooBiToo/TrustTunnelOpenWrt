/build/
/dist/
*.apk
*.tar.gz

# Локальная сборка в SDK: артефакты и вспомогательный скрипт.
# Воспроизводимая сборка описана в .github/workflows/release.yml.
.build-out/

# Локальные настройки инструментов и рабочее пространство агентов: настройки
# конкретной машины и промежуточные отчёты, которым не место в истории.
.claude/
.superpowers/

# Внутренние правила работы: в публичном репозитории им не место, но на диске
# они нужны.
CONTRIBUTING.md

# Каталог docs/ целиком внутренний: план и спецификация, приёмочный чеклист,
# журнал принятых решений, заметки о проверке на живом железе. Всё это нужно
# при разработке и ничего не даёт тому, кто просто ставит пакет.
#
# Документация ДЛЯ ПОЛЬЗОВАТЕЛЯ лежит в корне и отслеживается: README.md,
# README.en.md и SETTINGS.ru.md. Если сюда добавится ещё один пользовательский
# документ, его место тоже в корне, а не в docs/ — иначе он молча выпадет из
# репозитория, а ссылка на него из README окажется битой.
/docs/

# Мусор редакторов и файловых менеджеров.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Скачанные списки домены и локальные временные файлы, если кто-то
# запустит генераторы прямо в дереве репозитория.
/lists/
*.tsv.tmp
*.log
