#!/bin/sh
# Прогревает наборы обхода: резолвит свои домены через локальный dnsmasq,
# чтобы их адреса оказались в tt_bypass4/6 сразу после применения настроек.
# Использование: warm-sets <own-domains-file>
#
# ЗАЧЕМ. Наборы наполняет только dnsmasq и только отвечая от upstream, а
# `routing up` обнуляет их при каждом применении. Пока никто не спросил домен
# ЧЕРЕЗ РОУТЕР, его адреса в наборе нет и трафик идёт напрямую. Для списков
# сообщества это нормально — их тысячи, они наполняются по ходу дела. Но свой
# домен человек только что ввёл руками и ждёт, что тот заработает; при этом
# его устройство обычно уже держит адрес в собственном кэше DNS (сайт же
# открывали, чтобы проверить, идёт ли он через туннель) и роутер не
# спрашивает вовсе. Наблюдалось именно так: домен добавлен, правила
# применены, а внешний IP остаётся прежним — до первого запроса, который
# дошёл до dnsmasq. Этот скрипт делает такой запрос сам.
#
# Список приходит готовым файлом из gen-lists, а не собирается здесь заново:
# иначе нормализацию и вычитание «не обходить» пришлось бы повторить, и
# прогреть можно было бы домен, которого в dnsmasq.conf нет.
set -u

# Резолвер и паузы переопределяются из окружения по тому же образцу, что TT_IP
# и TT_NFT в routing: без этого ожидание dnsmasq нечем покрыть тестами на
# машине разработчика.
TT_NSLOOKUP="${TT_NSLOOKUP:-nslookup}"
TT_WARM_TRIES="${TT_WARM_TRIES:-15}"
TT_WARM_SLEEP="${TT_WARM_SLEEP:-1}"

LIST="${1:?usage: warm-sets <own-domains-file>}"

# Пустой список — не ошибка: своих доменов может не быть вовсе, а в полном
# режиме файла нет совсем.
[ -s "$LIST" ] || exit 0

resolve() { $TT_NSLOOKUP "$1" >/dev/null 2>&1; }

# Ждём, пока dnsmasq снова начнёт отвечать. link_dnsmasq могла только что
# перезапустить его, а `/etc/init.d/dnsmasq restart` возвращает управление ДО
# того как процесс снова слушает — ПРОВЕРЕНО на живом роутере: nslookup сразу
# после него не отвечает. Без ожидания прогрев отработал бы вхолостую и
# молча, то есть выглядел бы сделанным, ничего не сделав.
#
# Счёт в попытках, а не в секундах: с нулевой паузой (так гоняются тесты)
# счётчик секунд не растёт и цикл не кончается никогда.
first=$(head -1 "$LIST")
tries=0
until resolve "$first"; do
	tries=$((tries + 1))
	if [ "$tries" -ge "$TT_WARM_TRIES" ]; then
		logger -t trusttunnel \
			"warning: resolver did not answer in $tries tries; bypass sets will fill on the first client query"
		exit 0
	fi
	sleep "$TT_WARM_SLEEP"
done

# Первый домен прогрет циклом ожидания, поэтому он пропускается. Цикл читает
# ИЗ ФАЙЛА, а не из конвейера: в подоболочке конвейера счётчики не пережили бы
# выход из цикла, и сводка всегда была бы нулевой.
warmed=1
failed=0
n=0
while IFS= read -r d; do
	n=$((n + 1))
	[ "$n" = "1" ] && continue
	[ -n "$d" ] || continue
	if resolve "$d"; then
		warmed=$((warmed + 1))
	else
		failed=$((failed + 1))
	fi
done < "$LIST"

printf 'warmed %s\n' "$warmed"
printf 'failed %s\n' "$failed"

if [ "$failed" != "0" ]; then
	logger -t trusttunnel \
		"warning: $failed of $((warmed + failed)) own domains did not resolve during warm-up"
fi
logger -t trusttunnel "warmed $warmed own domain(s) into the bypass sets"
