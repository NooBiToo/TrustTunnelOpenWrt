#!/bin/sh
# Приводит список путей списков подсетей к каноническому виду: stdin -> stdout,
# по одному пути на строку. Снимает повторы и схлопывает регистровый дубль.
#
# ЗАЧЕМ. Репозиторий списков держит часть файлов подсетей в двух экземплярах,
# отличающихся только регистром имени: Subnets/IPv4/Meta.lst и
# Subnets/IPv4/meta.lst байт в байт одинаковы, то же с Twitter и Discord, и в
# обоих семействах адресов. Интерфейс показывал обе строки как разные списки,
# человек отмечал обе, и роутер скачивал один и тот же файл дважды. В nft это
# безвредно — auto-merge схлопывает одинаковые подсети, — но в оверлее лежат
# две копии, а при каждом обновлении списков делается лишний запрос.
#
# ПОЧЕМУ НЕ «понижать регистр всегда». Тогда в наборе оказался бы путь,
# которого в репозитории может не существовать: одинокий Subnets/IPv4/Meta.lst
# превратился бы в meta.lst, и если строчного файла там нет, fetch-lists
# печатал бы по нему `fail` при каждом обновлении. Присутствие ОБОИХ вариантов
# в одном наборе само по себе доказывает, что оба файла существовали на момент
# выбора, поэтому схлопывание безопасно ровно в этом случае — и только в нём.
set -u

# Ключ группировки — каталог как есть плюс имя файла в нижнем регистре.
# Понижать регистр всего пути нельзя: Subnets/IPv4 и Subnets/ipv4 — разные
# пути в git, и сведение их в один дало бы путь, которого нет ни в одном из
# вариантов.
#
# Диапазоны 'A-Z'/'a-z' взяты намеренно, а НЕ [:upper:]/[:lower:]: имена файлов
# здесь заведомо ASCII, а классы символов зависят от локали.
awk '
	{
		line = $0
		sub(/\r$/, "", line)
		sub(/^[ \t]+/, "", line)
		sub(/[ \t]+$/, "", line)
		if (line == "") next

		slash = 0
		for (i = length(line); i > 0; i--)
			if (substr(line, i, 1) == "/") { slash = i; break }
		dir = slash ? substr(line, 1, slash) : ""
		base = slash ? substr(line, slash + 1) : line
		key = dir tolower(base)

		# Порядок вывода — порядок первого появления: это выбор человека,
		# и переставлять его незачем.
		if (!(key in seen)) { order[++n] = key; seen[key] = 1; first[key] = line }
		if (!(key SUBSEP line in variant)) { variant[key SUBSEP line] = 1; kinds[key]++ }
		if (line == key) haskey[key] = 1
	}
	END {
		for (i = 1; i <= n; i++) {
			key = order[i]
			# Строчный вариант выбирается, только если он в наборе ЕСТЬ
			# (haskey) и есть с чем схлопывать (kinds > 1). Иначе печатается
			# та запись, которая пришла первой, — ровно как она записана.
			if (kinds[key] > 1 && haskey[key])
				print key
			else
				print first[key]
		}
	}
'
