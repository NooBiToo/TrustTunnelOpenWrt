#!/bin/sh
# Генерирует client.toml для trusttunnel_client из records-конфигурации.
# Использование: gen-config <records-file> [extra-exclusions-file] [pem-file]
set -u

TT_LIBDIR="${TT_LIBDIR:-$(dirname "$0")}"
# Путь вычисляется во время работы, статически линтеру его не разрешить.
# shellcheck disable=SC1091
. "$TT_LIBDIR/records.sh"

# TT_RECORDS читает подключённый records.sh через tt_get/tt_list — линтер
# этой связи не видит, потому что не следует за sourcing.
# shellcheck disable=SC2034
TT_RECORDS="${1:?usage: gen-config <records-file> [extra-exclusions-file] [pem-file]}"
EXTRA="${2:-}"
CERT_FILE="${3:-}"

die() { printf 'gen-config: %s\n' "$1" >&2; exit 1; }

# Экранирование для базовой TOML-строки: обратный слэш и кавычка.
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Печатает TOML-массив строк из значений на stdin, по одному на строку.
array_from_stdin() {
	awk '
		{
			gsub(/\\/, "\\\\")
			gsub(/"/, "\\\"")
			items[n++] = "\"" $0 "\""
		}
		END {
			out = ""
			for (i = 0; i < n; i++) out = out (i ? ", " : "") items[i]
			printf "[%s]", out
		}
	'
}

hostname=$(tt_get endpoint.hostname)
username=$(tt_get endpoint.username)
password=$(tt_get endpoint.password)
[ -n "$hostname" ] || die "endpoint.hostname is not set"
[ -n "$username" ] || die "endpoint.username is not set"
[ -n "$password" ] || die "endpoint.password is not set"
[ "$(tt_count endpoint.address)" != "0" ] || die "endpoint.address is not set"

mtu=$(tt_get network.mtu 1350)
loglevel=$(tt_get main.log_level info)
protocol=$(tt_get endpoint.protocol http2)
custom_sni=$(tt_get endpoint.custom_sni)
client_random=$(tt_get endpoint.client_random)

# Числовые ключи идут в TOML голыми числами. Мусор вместо числа сломал бы
# разбор конфига целиком, и клиент не стартовал бы вовсе — поэтому всё, что
# не целое неотрицательное число, заменяется значением по умолчанию.
uint_or() { # uint_or <key> <default>
	_v=$(tt_get "$1" "$2")
	case "$_v" in
		''|*[!0-9]*) printf '%s\n' "$2" ;;
		*) printf '%s\n' "$_v" ;;
	esac
}
preresolve_max=$(uint_or network.preresolve_max 50)
tcp_recv_buf=$(uint_or network.tcp_recv_buf 0)
tcp_send_buf=$(uint_or network.tcp_send_buf 0)
scannable_ports=$(tt_get network.scannable_ports '443,80,8080,8008,853')

# PEM выводится литеральной многострочной строкой TOML: апострофов в PEM быть
# не может, поэтому экранирование не нужно. `awk 1` нормализует файл, добавляя
# перевод строки в конце, если его нет, — иначе закрывающие апострофы
# приклеились бы к последней строке сертификата.
emit_certificate() {
	if [ -n "$CERT_FILE" ] && [ -s "$CERT_FILE" ]; then
		printf "certificate = '''\n"
		awk 1 "$CERT_FILE"
		printf "'''"
	else
		printf 'certificate = ""'
	fi
}

addresses=$(tt_list endpoint.address | array_from_stdin)
dns_upstreams=$(tt_list endpoint.dns_upstream | array_from_stdin)

# exclusions = «не обходить». В режиме full к ним по флагу добавляются
# домены выбранных списков, которые готовит вызывающая сторона.
exclusions=$( { tt_list domains.direct; [ -n "$EXTRA" ] && [ -f "$EXTRA" ] && cat "$EXTRA"; } | array_from_stdin )

# В [listener.tun] НЕТ ключей device_name и use_existing, и это намеренно.
# История: раньше они здесь генерировались в расчёте на то, что клиент возьмёт
# созданное нами устройство. Клиент 1.0.49 этих ключей не знал, молча
# игнорировал их и всегда создавал СВОЁ устройство, а наше оставалось без
# носителя: маршрут в таблице 880 указывал в мёртвый интерфейс, помеченный
# трафик отбрасывался, и при этом check_domain отвечал "verdict: tunnel".
# С клиента 1.0.62 ключи в схеме ЕСТЬ (сверено с эталоном setup_wizard 1.1.5
# и с CHANGELOG вендора), но пакет ими по-прежнему не пользуется: устройство
# создаёт клиент, а маршрут к нему привязывается после старта (routing
# attach) — так одна и та же схема работает и на старых клиентах, которые
# ключи игнорируют, и на новых.
#
# Ключи exclusions_* и tcp_*_buf_size появились в клиенте 1.0.63 и 1.1.5;
# клиенты старше молча их игнорируют (проверено на 1.0.49). early-ack включён
# по умолчанию ВОПРЕКИ дефолту клиента, по рекомендации вендора: режим нужен,
# когда DNS резолвит не клиент (у нас — роутер) и для wildcard-исключений.
# Проверено на стенде 5 сентября 2026: исключение обычного домена по SNI
# срабатывает и без него, и на 1.0.49 тоже — это страховка, а не условие.
#
# included_routes и excluded_routes оставлены ПУСТЫМИ намеренно: маршрутизацию
# держим мы — через отметку и таблицу 880. Отдать их клиенту означало бы
# потерять избирательность по спискам, потому что он проложит маршрут для всего.
cat <<TOML
# Generated by luci-app-trusttunnel. Do not edit: changes are overwritten.
loglevel = "$(esc "$loglevel")"
vpn_mode = "general"
killswitch_enabled = false
post_quantum_group_enabled = $(tt_bool endpoint.post_quantum 1)
exclusions_tcp_early_ack_enabled = $(tt_bool network.early_ack 1)
exclusions_preresolve_enabled = $(tt_bool network.preresolve 1)
exclusions_preresolve_max_queries = ${preresolve_max}
exclusions_scannable_ports = "$(esc "$scannable_ports")"
exclusions = ${exclusions}

[endpoint]
hostname = "$(esc "$hostname")"
addresses = ${addresses}
custom_sni = "$(esc "$custom_sni")"
has_ipv6 = $(tt_bool endpoint.has_ipv6 1)
username = "$(esc "$username")"
password = "$(esc "$password")"
client_random = "$(esc "$client_random")"
skip_verification = $(tt_bool endpoint.skip_verification 0)
$(emit_certificate)
upstream_protocol = "$(esc "$protocol")"
anti_dpi = $(tt_bool endpoint.anti_dpi 0)
dns_upstreams = ${dns_upstreams}

[listener.tun]
included_routes = []
excluded_routes = []
mtu_size = ${mtu}
tcp_recv_buf_size = ${tcp_recv_buf}
tcp_send_buf_size = ${tcp_send_buf}
change_system_dns = false
TOML
