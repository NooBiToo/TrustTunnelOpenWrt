#!/bin/sh
# Нормализует список доменов: stdin -> stdout, по одному домену на строку.
# Число отброшенных записей уходит на stderr как "dropped <N>".
# Правила описаны в разделе 3.4 дизайн-документа.

# Диапазоны 'A-Z'/'a-z' взяты намеренно, а НЕ [:upper:]/[:lower:], которые
# советует shellcheck: это нормализация ДОМЕННЫХ имён, где допустим только
# ASCII. Классы символов зависят от локали и могли бы свернуть регистр
# не-ASCII букв, которые обязаны отбраковываться дальше по конвейеру, а не
# приводиться к нижнему регистру и проходить как валидные.
# shellcheck disable=SC2018,SC2019
tr 'A-Z' 'a-z' | awk '
	{
		line = $0
		sub(/\r$/, "", line)                   # CRLF -> LF
		sub(/#.*$/, "", line)                  # комментарии
		sub(/^[ \t]+/, "", line)               # ведущие пробелы
		sub(/[ \t]+$/, "", line)               # хвостовые пробелы
		if (line == "") next

		sub(/^\*\./, "", line)                 # *.example.com -> example.com
		sub(/^\./, "", line)                   # .ua -> ua
		sub(/\.$/, "", line)                   # example.com. -> example.com
		if (line == "") { dropped++; next }

		# Голый IPv4 в списке доменов — данные не того рода.
		if (line ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { dropped++; next }

		if (line ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$/) {
			if (!seen[line]++) print line
			next
		}
		dropped++
	}
	END { if (dropped) printf "dropped %d\n", dropped > "/dev/stderr" }
'
