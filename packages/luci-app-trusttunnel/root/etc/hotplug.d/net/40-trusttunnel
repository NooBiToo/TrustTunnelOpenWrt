#!/bin/sh
# Восстанавливает привязку маршрута, когда клиент пересоздаёт своё
# tun-устройство. Такое происходит на обычном пути: procd перезапускает
# упавший клиент, тот делает устройство заново, а маршрут по умолчанию в
# таблице 880 исчезает вместе с прежним устройством — потому что удаление
# интерфейса уносит все ссылающиеся на него маршруты.
#
# Без этого скрипта после каждого перезапуска клиента помеченный трафик
# оставался бы в blackhole до ручного перезапуска службы: туннель работает,
# а трафик в него не идёт.

[ "$ACTION" = "add" ] || exit 0

dev="${INTERFACE:-$DEVICENAME}"
[ -n "$dev" ] || exit 0

# Только tun-устройства: признак — наличие tun_flags в sysfs.
[ -e "/sys/class/net/$dev/tun_flags" ] || exit 0

# И только НЕ persistent: бит IFF_PERSIST (0x0800) стоит у устройств,
# созданных вручную через `ip tuntap add`, а клиент создаёт своё без него.
# Проверка отсекает чужие постоянные интерфейсы, включая tt0, оставшийся
# на роутерах от прежних версий пакета.
flags=$(cat "/sys/class/net/$dev/tun_flags" 2>/dev/null) || exit 0
# Арифметика, а не разбор строки по позициям символов: busybox ash понимает
# шестнадцатеричные литералы (проверено на роутере — 0x1801 & 0x800 = 2048,
# 0x1001 & 0x800 = 0), а сравнение по позиции ломалось бы на любой другой
# ширине значения.
[ "$(( flags & 0x800 ))" = "0" ] || exit 0

RECORDS=/var/etc/trusttunnel/settings.tsv
OUTDIR=/var/etc/trusttunnel
[ -f "$RECORDS" ] || exit 0

# Служба должна считаться работающей: иначе привязывать нечего и незачем.
/etc/init.d/trusttunnel running >/dev/null 2>&1 || exit 0

# Если уже привязаны к живому устройству — не трогаем. Так событие от
# постороннего интерфейса не переключит нас с работающего туннеля.
cur=$(cat "$OUTDIR/device" 2>/dev/null)
if [ -n "$cur" ] && [ -d "/sys/class/net/$cur" ] && [ "$cur" != "$dev" ]; then
	exit 0
fi

/usr/libexec/trusttunnel/routing attach "$RECORDS" "$OUTDIR" "$dev" \
	&& logger -t trusttunnel "hotplug: reattached routing to $dev"
